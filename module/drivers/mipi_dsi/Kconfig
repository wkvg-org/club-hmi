config MIPI_DSI_ESP32
	bool "Espressif ESP32-P4 MIPI-DSI Host Controller"
	default y
	depends on DT_HAS_ESPRESSIF_ESP_MIPI_DSI_ENABLED
	depends on SOC_SERIES_ESP32P4
	select MIPI_DSI
	select REGULATOR
	help
	  Enable the MIPI-DSI host + bridge controller driver for the
	  Espressif ESP32-P4. Provides the mipi_dsi_driver_api (attach and
	  LP command transfer) used by DSI panel drivers; the actual
	  framebuffer/DMA scan-out is handled by a separate
	  espressif,esp32-mipi-dsi-dpi device (see drivers/display).
